{
  "name": "service-tunnels",
  "version": "0.3.41",
  "description": "Service port discovery + wildcard-host proxy + tunnels (ngrok/frpc/ssh/cloudflared/localtunnel) + nginx/Authelia/Redis auth orchestration. Library + CLI.",
  "type": "module",
  "bin": {
    "service-tunnels": "./dist/cli.js",
    "sts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/index.ts": "./src/index.ts",
    "./src/*.ts": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build:justget && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && node scripts/copy-vendor.mjs",
    "prepack": "npm run build:justget && npm run build",
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build:justget": "node scripts/build-justget.mjs"
  },
  "keywords": [
    "tunnel",
    "ngrok",
    "ngrok-alternative",
    "cloudflared",
    "localtunnel",
    "frp",
    "frpc",
    "serveo",
    "bore",
    "natapp",
    "ssh",
    "reverse-proxy",
    "port-forwarding",
    "port-discovery",
    "localhost",
    "vhost",
    "expose",
    "share",
    "dev-server",
    "cli",
    "developer-tools",
    "authelia",
    "oauth2",
    "authentication",
    "forward-auth",
    "2fa",
    "totp",
    "nginx"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "justget": "^0.1.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
