{
  "name": "service-tunnels",
  "version": "0.2.39",
  "description": "Service port discovery + wildcard-host proxy + tunnels (ngrok/frpc/ssh/cloudflared/localtunnel) + nginx/Authelia/Redis auth orchestration. Library + CLI.",
  "type": "module",
  "bin": {
    "service-tunnels": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/index.ts": "./src/index.ts",
    "./src/*.ts": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "prepack": "npm run build",
    "test": "node --test --test-force-exit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tunnel",
    "ngrok",
    "frp",
    "authelia",
    "nginx",
    "port-discovery",
    "reverse-proxy"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "justget": "^0.1.1"
  }
}
